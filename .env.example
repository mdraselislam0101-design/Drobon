# Drobon Aegis AI — environment template (cumulative Pumps 1–15)
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Never commit a real `.env` file. This template contains no secrets —
# passwords are hashed with scrypt at runtime and session tokens are
# random per login; no key material is configured anywhere in Pump 4.
# The account store holds the authoritative subscription state (FREE/PRO).
# Pump 15 adds durable manual payment requests and admin review only; no
# online gateway, webhook or automated payment verification is implemented.
# The usage store holds only opaque quota counters.

# --- API (@drobon/api) -------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Bind address. Loopback by default; set 0.0.0.0 only where required.
HOST=127.0.0.1
# API port. The Web dev server proxies /api, /livez, /readyz to this port.
PORT=3001
# One of: debug | info | warn | error
LOG_LEVEL=info
# Comma-separated list of allowed browser origins for CORS (exact origins).
# Also consulted by the CSRF origin guard for unsafe (POST/PUT/PATCH/DELETE)
# requests. Include the Web dev origin for split-port (non-proxy) setups.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Rate limit: max requests per window, per client IP.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
# Max JSON request body size in bytes.
BODY_MAX_BYTES=1048576

# --- Authentication (Pump 2) -------------------------------------------------
# Durable account store (minimum auth persistence boundary). A filesystem
# path, or ":memory:" for explicitly ephemeral dev/test setups — the latter
# is REJECTED when NODE_ENV=production. File lives under a gitignored dir.
AUTH_STORE_PATH=.data/users.json
# scrypt cost parameter N (power of two, 1024–1048576). Default 32768 ≈
# 32 MiB per hash; tests lower it for speed through config overrides only.
AUTH_SCRYPT_COST=32768
# Absolute session lifetime in seconds (default 7 days, 60–2592000).
AUTH_SESSION_TTL_SECONDS=604800
# Dedicated rate limit for /api/v1/auth/* (register/login/logout), per IP.
AUTH_RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Session cookie `Secure` attribute is derived automatically:
# enabled when NODE_ENV=production, omitted on plain-HTTP localhost dev.

# --- Usage / quota (Pump 5) --------------------------------------------------
# Durable usage-counter store for the FREE monthly scan allowance and the
# shared-device allowance. A filesystem path, or ":memory:" for ephemeral
# dev/test setups — the latter is REJECTED when NODE_ENV=production.
# The dev/test-only consume probe (POST /api/v1/usage/consume) is enabled
# automatically outside production; there is no flag to enable it in
# production. See docs/USAGE.md.
USAGE_STORE_PATH=.data/usage.json

# Durable project store (Pump 6): the user-owned containers future scans
# attach to. Same persistence pattern as the account/usage stores; a
# filesystem path, or ":memory:" for ephemeral dev/test — REJECTED when
# NODE_ENV=production. See docs/PROJECTS.md.
PROJECT_STORE_PATH=.data/projects.json

# Durable scan-job store (Pump 7): the orchestration records future
# scanner engines process. Same persistence pattern as the other stores;
# a filesystem path, or ":memory:" for ephemeral dev/test — REJECTED
# when NODE_ENV=production. See docs/SCANS.md.
SCAN_STORE_PATH=.data/scans.json

# Durable Security Professional assessments (Pump 22): bounded project-scoped
# scope/objectives, append-only lifecycle and user authorization declarations.
# Declarations are USER_DECLARED/UNVERIFIED metadata, never permission proof
# or a DAST-policy bypass. :memory: is rejected in production.
ASSESSMENT_STORE_PATH=.data/assessments.json

# Durable source-snapshot store (Pump 8): the SAST scan target per
# project (uploaded source, never executed). Same persistence pattern
# as the other stores; a filesystem path, or ":memory:" for ephemeral
# dev/test — REJECTED when NODE_ENV=production. See docs/SAST.md.
SOURCE_STORE_PATH=.data/sources.json

# Vulnerability-intelligence provider (Pump 9): THE DATASET LOCK in
# config form. Must be "none" — no CVE/NVD/GHSA/OSV/KEV/EPSS data is
# bundled or vendored, ever. With "none", SCA scans honestly report
# NOT_ASSESSED (inventory + SBOM are still real). Any other value is
# REJECTED at startup; a real dataset integration is a separate future
# deployment. See docs/SCA.md.
VULN_INTEL_PROVIDER=none

# --- Payments / PRO request foundation (Pump 15) -----------------------------
# Durable payment requests + audit events. :memory: is rejected in production.
PAYMENT_STORE_PATH=.data/payments.json
# Server-owned price in BDT poisha (100000 = BDT 1000.00); client amounts
# must exactly match. Currency remains BDT; there are no coupons/discounts.
PRO_PRICE_MINOR_UNITS=100000
# Exact server-assigned user IDs of platform reviewers. Empty means nobody
# can review. Each listed user must also have live account role ADMIN; neither
# that role nor allowlisting a non-ADMIN account is sufficient alone.
PAYMENT_REVIEWER_IDS=
# Only manual reference submission exists. This is not a gateway integration.
PAYMENT_MANUAL_METHODS=MANUAL_TRANSFER
# Shown to users; replace with accurate instructions before accepting funds.
# Default intentionally tells users not to send money until support replies.
PAYMENT_MANUAL_INSTRUCTIONS=Payment instructions are not configured. Contact support before sending funds. A submitted reference is user-provided evidence and is not payment verification.
# Additional fixed-window limit for payment mutation requests, per direct IP.
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10
PAYMENT_RATE_LIMIT_WINDOW_MS=60000

# --- Platform-admin read-only operations (Pump 16) ---------------------------
# Empty by default: no account is a platform administrator. Each ID must
# resolve to a live account with role ADMIN. This is not client-editable.
PLATFORM_ADMIN_IDS=
ADMIN_RATE_LIMIT_MAX_REQUESTS=60
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# --- Admin complimentary PRO grants (entitlements, not payments) -------------
# Durable ADMIN_GRANT entitlements + audit events. :memory: is rejected in
# production. Grants never create payment/balance/commission records.
ENTITLEMENT_STORE_PATH=.data/entitlements.json

# --- Web (@drobon/web, dev/preview servers) ----------------------------------
# Comma-separated list of hosts allowed to reach the Vite dev/preview server.
# Use "*" only inside throwaway sandboxes, never on shared infrastructure.
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=5173
PREVIEW_PORT=4173

# --- Web (public build-time config — embedded in the browser bundle) ---------
# WARNING: never put secrets in VITE_* variables. They ship to the browser.
# Same-origin by default (empty). Example for split hosting:
# VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=
VITE_APP_NAME=Drobon Aegis AI
VITE_APP_ENV=development
